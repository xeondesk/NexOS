# NexOS environment file (never commit real values — this is the template).
# Written by `nexos init` from your identity / control-plane secrets.
#
# Used by:
#   - lib/metrics.sh   (NEXOS_CALLBACK_URL / _TOKEN / _DEPLOYMENT_TARGET)
#   - git/ssh-sign.sh  (NEXOS_GIT_SIGN_URL, NEXOS_GIT_SIGN_NAMESPACE)
#   - lib/log-proxy.js + bridge (NEXOS_LOG_PROXY_TOKEN, NEXOS_BRIDGE_TOKEN)
#
# Legacy v0 names are also accepted as a fallback for migration.

NEXOS_CALLBACK_URL=''
NEXOS_CALLBACK_TOKEN=''
NEXOS_CALLBACK_DEPLOYMENT_TARGET=''

# Bearer tokens for remote control-plane clients (only enforced on
# non-loopback requests, i.e. when NEXOS_ALLOW_REMOTE=true).
NEXOS_LOG_PROXY_TOKEN=''
NEXOS_BRIDGE_TOKEN=''

# Per-service overrides (mirror v0's .env.project split). When set, metrics and
# editor hosts prefer these over the generic NEXOS_CALLBACK_* values above.
NEXOS_CODE_SERVER_CALLBACK_URL=''
NEXOS_CODE_SERVER_CALLBACK_TOKEN=''
NEXOS_RUNTIME_URL=''

# Git signing. By default SSH signatures proxy to the legacy v0 service. To use
# the self-hosted reference sign service instead, point NEXOS_GIT_SIGN_URL at it
# (it must also be configured: generate a key with `nexos sign-keygen`, set
# NEXOS_GIT_SIGN_KEY, and start the git-sign service):
#   NEXOS_GIT_SIGN_URL='http://127.0.0.1:9877/sign'
NEXOS_GIT_SIGN_URL='https://git-sign.v0.app/sign'
NEXOS_GIT_SIGN_NAMESPACE=''
NEXOS_GIT_SIGN_TOKEN=''
