# NexOS environment file (never commit real values — this is the template).
# Written by `nexos init` from your identity / control-plane secrets.
#
# Used by:
#   - lib/metrics.sh   (NEXOS_CALLBACK_URL / _TOKEN / _DEPLOYMENT_TARGET)
#   - git/ssh-sign.sh  (NEXOS_GIT_SIGN_URL, NEXOS_GIT_SIGN_NAMESPACE)
#
# Legacy v0 names are also accepted as a fallback for migration.

NEXOS_CALLBACK_URL=''
NEXOS_CALLBACK_TOKEN=''
NEXOS_CALLBACK_DEPLOYMENT_TARGET=''

NEXOS_GIT_SIGN_URL='https://git-sign.v0.app/sign'
NEXOS_GIT_SIGN_NAMESPACE=''
